	PlanetShaper: {
		DisplayName: 行星塑形者
		Tooltip:
			'''
			这把镰刀是定向挥舞而不是旋转
			拥有三段连击：
				第一段挥击会发射一枚追踪火球和2道宇宙光束
				第二段挥击会发射一道宇宙光束和2枚追踪火球
				第三段挥击会旋转镰刀
				旋转期间，最多会发射6枚追踪火球和宇宙光束
			镰刀和火球无视125点防御，并造成[iabuff:CalamityMod/Dragonfire]
			宇宙光束无视75点防御，并造成[iabuff:CalamityMod/ElementalMix]和[iabuff:CatalystMod/AstralBlight]
			“女士们先生们……摇起来摇起来摇起来！！！”
			'''
	}

	GodsPitch: {
