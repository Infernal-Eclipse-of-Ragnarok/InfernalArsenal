	PocketConcert: {
		DisplayName: I-PMA：机械增强电音蝌蚪
		Tooltip:
			'''
			释放多种不同颜色的音符
			音符将根据其颜色造成不同的减益
			每拥有一种2级或以上的咒音增幅效果，会额外释放一枚音符，最多额外释放五枚
			[c/1FFBFF:我曾被派去寻找那个自称“追猎者”的战士团体]
			[c/1FFBFF:他们向我展示了一件奇怪的乐器，形如音符，却长着一张嘴]
			[c/1FFBFF:尽管这东西十分怪异，我仍设法将其改造成了一件武器，其威力会随着使用者所拥有的其他强化数量而增强]
			[c/1FFBFF:不过，这也迫使我将它的体型制造得远比原本的乐器更为庞大]
			'''
	}

	GammaKnife: {
