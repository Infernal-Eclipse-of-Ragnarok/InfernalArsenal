UI.Cooldowns.ImagiknightHeraldryBuff: 幻想骑士之力

Items: {
	TwoPaths: {
		DisplayName: 神冥歧径
		Tooltip:
			'''
			直接击中会获得4层灵魂精华
			左键驱动镰刀造成大范围伤害
			右键消耗魔力，召唤洁白之镰斩击敌人
			'''
	}

	TheParallel: {
		Tooltip:
			'''
			从异次元召唤一阵宇宙飞刀
			宇宙飞刀在反弹后会进入伏击状态
			处于伏击状态的飞刀会蓄力一段时间
			蓄力完成后，它们会攻击第一个靠近的敌人并造成三倍伤害
			同时最多只能有27把飞刀处于伏击状态
			超过27把上限后，反弹的宇宙飞刀会直接追踪最近的目标
			'''
		DisplayName: 平行音律
	}

	SuperShotgun: {
		Tooltip:
			'''
			右键使用刺刀突刺，造成近战伤害
