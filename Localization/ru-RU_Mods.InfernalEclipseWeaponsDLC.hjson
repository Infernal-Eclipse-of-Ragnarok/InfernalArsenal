	ExecutionersSword: {
		DisplayName: Меч палача
		Tooltip:
			'''
			Нажмите ЛКМ, чтобы взмахнуть мечом, восстанавливая 5 ед. здоровья при попадании
			Нажмите ПКМ, чтобы метнуть меч, который вонзается в поражённого врага
			Когда меч вонзён, он испускает светлую и тёмную энергию
			Светлая энергия наводится на ближайших союзников и исцеляет здоровье на сумму, равное бонусному лечению
			Тёмная энергия наводится на ближайших врагов, нанося урон
			Одновременно можно метнуть только один меч
			Обладает силой вершить Казнь
			'Конфискация... и СМЕРТЬ!'
			'''
	}

	ButchersBloodmaker: {
		DisplayName: Кроводел мясника
		Tooltip:
			'''
			Выпускает разброс из пуль и слегка наводящуюся кровавую стрелу
			При нажатии ПКМ, расходует 50 ед. здоровья, впадая в кровавую ярость на 10 секунд
			Кровавая ярость увеличивает урон кроводела на 25%, а кровавые стрелы накладывают дебафф [cbuff:CalamityMod/BurningBlood]
			'''
	}

